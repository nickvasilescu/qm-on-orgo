#!/usr/bin/env python3
"""Render /opt/qm/qm.config.jsonc and the settings part of /opt/qm/.env.

Inputs, later wins:
  /root/.env        template secrets injected by Orgo at launch
  /opt/qm/orgo.env  settings saved by qm-public / qm-email on this computer

Settings:
  ANTHROPIC_API_KEY        base model key (optional; can be added in Admin > Onboarding instead)
  QM_PUBLIC_URL            https://<label>.orgo.dev or a custom domain. Unset = localhost test drive.
  RESEND_API_KEY           enables email sign-in links (needs QM_EMAIL_FROM)
  QM_EMAIL_FROM            verified Resend sender, e.g. "QM <qm@yourdomain.com>"
  QM_ADMIN_EMAIL           a real admin who can sign in by email
  QM_ALLOWED_EMAIL_DOMAIN  anyone @this domain may sign in, e.g. acme.com
  QM_ALLOWED_EMAILS        comma-separated extra addresses allowed to sign in

Signing secrets in .env are generated once per computer by qm-start and never touched here.
"""
import json
import os
import re
import sys

QM = "/opt/qm"
LOCAL_ADMIN = "admin@qm.local"
MANAGED = ["ANTHROPIC_API_KEY", "RESEND_API_KEY", "AUTH_EMAIL_FROM", "AUTH_ALLOWED_EMAILS"]


def read_env(path):
    out = {}
    try:
        for line in open(path):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                v = v[1:-1]
            out[k.strip()] = v
    except FileNotFoundError:
        pass
    return out


def main():
    s = {}
    s.update(read_env("/root/.env"))
    s.update(read_env(f"{QM}/orgo.env"))
    get = lambda k: (s.get(k) or "").strip()

    public = get("QM_PUBLIC_URL").rstrip("/")
    if public and not re.fullmatch(r"https://[a-z0-9.-]+", public):
        sys.exit(f"QM_PUBLIC_URL must look like https://name.orgo.dev (got {public!r})")

    admin = get("QM_ADMIN_EMAIL").lower()
    grants = [f"{LOCAL_ADMIN}:org_admin"] + ([f"{admin}:org_admin"] if admin else [])
    allowed = [LOCAL_ADMIN] + ([admin] if admin else [])
    allowed += [e.strip().lower() for e in get("QM_ALLOWED_EMAILS").split(",") if e.strip()]

    auth_env = {"AUTH_EMAIL_TRANSPORT": "resend"}
    if get("QM_ALLOWED_EMAIL_DOMAIN"):
        auth_env["AUTH_ALLOWED_EMAIL_DOMAIN"] = get("QM_ALLOWED_EMAIL_DOMAIN").lower().lstrip("@")

    cfg = {
        "contract": 1,
        "orgId": "orgo",
        "publicUrl": public or "http://localhost:18081",
        "basePort": 18080,
        "target": "docker",
        "sandbox": {"backend": "local"},
        "services": ["core", "web-ui", "admin", "portal", "auth"],
        "plugins": [],
        "skills": [],
        "env": {
            "core": {"HARNESS": "pi", "ADMIN_GRANTS": ",".join(grants)},
            "auth": auth_env,
        },
    }
    if get("ANTHROPIC_API_KEY"):
        cfg["modelProvider"] = "anthropic"
    if not public:
        # Plain-http localhost test drive; production portal insists on https.
        cfg["env"]["portal"] = {"NODE_ENV": "development"}

    header = "// Generated by qm-configure on each start. Edit /opt/qm/orgo.env or use qm-public / qm-email.\n"
    with open(f"{QM}/qm.config.jsonc", "w") as f:
        f.write(header + json.dumps(cfg, indent=2) + "\n")

    managed = {"AUTH_ALLOWED_EMAILS": ",".join(dict.fromkeys(allowed))}
    if get("ANTHROPIC_API_KEY"):
        managed["ANTHROPIC_API_KEY"] = get("ANTHROPIC_API_KEY")
    if get("RESEND_API_KEY"):
        if not get("QM_EMAIL_FROM"):
            sys.exit("RESEND_API_KEY is set but QM_EMAIL_FROM is not (a sender verified in Resend)")
        managed["RESEND_API_KEY"] = get("RESEND_API_KEY")
        managed["AUTH_EMAIL_FROM"] = get("QM_EMAIL_FROM")

    env_path = f"{QM}/.env"
    kept = [l for l in open(env_path).read().splitlines()
            if l.split("=", 1)[0].strip() not in MANAGED] if os.path.exists(env_path) else []
    os.umask(0o077)
    with open(env_path, "w") as f:
        f.write("\n".join(kept + [f"{k}={v}" for k, v in managed.items()]) + "\n")

    mode = public or "http://localhost:18081 (local test drive)"
    email = "on" if "RESEND_API_KEY" in managed else "off (admin-login links only)"
    print(f"qm-configure: url={mode} email={email} admins={','.join(g.split(':')[0] for g in grants)}")


if __name__ == "__main__":
    main()
